# =============================================================================
# VR STREET KARAMA - ENVIRONMENT CONFIGURATION (TEMPLATE)
# Hosting: Vercel | Database: Supabase PostgreSQL
# =============================================================================

# Application URLs & Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="VR Street Karama"
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_CURRENCY_CODE="INR"

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key-here

# -----------------------------------------------------------------------------
# SUPABASE SERVICE ROLE KEY (STRICTLY SERVER-SIDE ONLY - NEVER EXPOSE IN CLIENT!)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key-here
